    { "id": "c1-018", "from": "team.lead@sdworx.example", "created_at": "2026-10-07T15:40:00+02:00", "text": "IT is on it, should be fixed in an hour", "reply_to_id": "c1-016", "reactions": [] },
    { "id": "c1-019", "from": "employee.c@sdworx.example", "created_at": "2026-10-08T09:05:00+02:00", "text": "the coffee machine on 3 is broken again ☕💀", "reply_to_id": null, "reactions": [] },
