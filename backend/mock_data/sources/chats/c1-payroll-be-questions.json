    { "id": "c1-022", "from": "employee.b@sdworx.example", "created_at": "2026-10-09T11:12:00+02:00", "text": "are freelancer travel costs paid via payroll?", "reply_to_id": null, "reactions": [] },
    { "id": "c1-023", "from": "employee.b@sdworx.example", "created_at": "2026-10-09T11:13:00+02:00", "text": "one of my contractors sent train tickets as a separate expense note", "reply_to_id": null, "reactions": [] },
    { "id": "c1-024", "from": "team.lead@sdworx.example", "created_at": "2026-10-09T14:30:00+02:00", "text": "no — freelancers invoice travel costs themselves, we only process the invoice", "reply_to_id": "c1-022", "reactions": [] },
    { "id": "c1-025", "from": "team.lead@sdworx.example", "created_at": "2026-10-09T14:32:00+02:00", "text": "so ask them to put the tickets on their invoice, not on a separate note", "reply_to_id": null, "reactions": [] },
    { "id": "c1-026", "from": "employee.a@sdworx.example", "created_at": "2026-10-09T14:35:00+02:00", "text": "yep, correct", "reply_to_id": "c1-024", "reactions": [] },
    { "id": "c1-027", "from": "employee.b@sdworx.example", "created_at": "2026-10-09T14:41:00+02:00", "text": "ok thx", "reply_to_id": null, "reactions": [] },
