    { "id": "c1-001", "from": "team.lead@sdworx.example", "created_at": "2026-10-01T08:47:00+02:00", "text": "morning all ☀️", "reply_to_id": null, "reactions": [] },
    { "id": "c1-002", "from": "employee.b@sdworx.example", "created_at": "2026-10-01T08:52:00+02:00", "text": "morning!", "reply_to_id": null, "reactions": [] },
    { "id": "c1-003", "from": "employee.b@sdworx.example", "created_at": "2026-10-02T09:14:00+02:00", "text": "how do we handle a CN from a contractor if the original invoice was already paid?", "reply_to_id": null, "reactions": [] },
    { "id": "c1-004", "from": "employee.b@sdworx.example", "created_at": "2026-10-02T09:15:00+02:00", "text": "it's for one of my contractors, they invoiced 2 days too many in september", "reply_to_id": null, "reactions": [] },
    { "id": "c1-005", "from": "employee.a@sdworx.example", "created_at": "2026-10-02T11:02:00+02:00", "text": "good question, I always forget too 😅 @Senior Expert?", "reply_to_id": "c1-003", "reactions": [], "mentions": ["senior.expert@sdworx.example"] },
    { "id": "c1-006", "from": "employee.c@sdworx.example", "created_at": "2026-10-02T11:45:00+02:00", "text": "lunch at 12?", "reply_to_id": null, "reactions": [] },
    { "id": "c1-007", "from": "employee.a@sdworx.example", "created_at": "2026-10-02T11:47:00+02:00", "text": "yes 🍝", "reply_to_id": "c1-006", "reactions": [] },
    { "id": "c1-008", "from": "senior.expert@sdworx.example", "created_at": "2026-10-02T13:40:12+02:00", "text": "don't pay it out", "reply_to_id": "c1-003", "reactions": [] },
    { "id": "c1-009", "from": "senior.expert@sdworx.example", "created_at": "2026-10-02T13:40:31+02:00", "text": "register it and deduct it from the next invoice of the same contractor", "reply_to_id": null, "reactions": [] },
    {
      "id": "c1-010", "from": "senior.expert@sdworx.example", "created_at": "2026-10-02T13:41:05+02:00",
      "text": "if there's no next invoice within 2 months, ask Finance for a refund request", "reply_to_id": null,
      "reactions": [
