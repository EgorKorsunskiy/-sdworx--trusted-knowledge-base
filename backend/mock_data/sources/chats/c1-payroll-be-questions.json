        { "emoji": "❤️", "by": "employee.b@sdworx.example" }
      ]
    },
    { "id": "c1-011", "from": "employee.c@sdworx.example", "created_at": "2026-10-02T14:05:00+02:00", "text": "confirmed, did exactly that last month 👍", "reply_to_id": "c1-010", "reactions": [] },
    { "id": "c1-012", "from": "employee.b@sdworx.example", "created_at": "2026-10-02T14:10:00+02:00", "text": "thx!!", "reply_to_id": null, "reactions": [] },
    { "id": "c1-013", "from": "employee.c@sdworx.example", "created_at": "2026-10-06T10:03:00+02:00", "text": "where's the monthly contractor overview template again?", "reply_to_id": null, "reactions": [] },
