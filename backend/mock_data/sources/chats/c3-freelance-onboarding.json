    { "id": "c3-001", "from": "manager@sdworx.example", "created_at": "2026-10-05T09:00:00+02:00", "text": "Hi all, I created this chat to align on freelancer onboarding across teams. @Senior Expert can you kick off?", "reply_to_id": null, "reactions": [], "mentions": ["senior.expert@sdworx.example"] },
    {
      "id": "c3-002", "from": "senior.expert@sdworx.example", "created_at": "2026-10-05T09:45:00+02:00",
      "text": "Proposal for the onboarding checklist for every new freelancer:\n1. check the company number in the KBO/BCE public search\n2. collect proof of affiliation with a social insurance fund\n3. for foreign freelancers: Limosa L1 receipt and A1 certificate\n4. signed contract without fixed working hours",
      "reply_to_id": null,
      "reactions": [
        { "emoji": "👍", "by": "employee.b@sdworx.example" },
        { "emoji": "👍", "by": "admin@sdworx.example" }
      ]
    },
    { "id": "c3-003", "from": "manager@sdworx.example", "created_at": "2026-10-05T10:02:00+02:00", "text": "Approved — this is our checklist from now on. @Senior Expert can you add it to Peerpoint?", "reply_to_id": "c3-002", "reactions": [], "mentions": ["senior.expert@sdworx.example"] },
    { "id": "c3-004", "from": "employee.a@sdworx.example", "created_at": "2026-10-05T10:03:00+02:00", "text": "finally 🙌", "reply_to_id": "c3-002", "reactions": [] },
