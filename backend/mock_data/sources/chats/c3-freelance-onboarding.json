    { "id": "c3-016", "from": "employee.b@sdworx.example", "created_at": "2026-10-09T13:05:00+02:00", "text": "question for the group: do we accept freelancers who don't have their own website? one of mine only has a linkedin", "reply_to_id": null, "reactions": [] },
    { "id": "c3-017", "from": "employee.a@sdworx.example", "created_at": "2026-10-09T13:12:00+02:00", "text": "if they don't have a website they're not a real freelancer imo", "reply_to_id": "c3-016", "reactions": [] },
    { "id": "c3-018", "from": "employee.b@sdworx.example", "created_at": "2026-10-09T13:15:00+02:00", "text": "that's a bit harsh? lots of freelancers only use linkedin", "reply_to_id": "c3-017", "reactions": [] },
    { "id": "c3-019", "from": "employee.a@sdworx.example", "created_at": "2026-10-09T13:18:00+02:00", "text": "it's a red flag for schijnzelfstandigheid though", "reply_to_id": "c3-018", "reactions": [] },
    { "id": "c3-020", "from": "employee.b@sdworx.example", "created_at": "2026-10-09T13:20:00+02:00", "text": "the checklist doesn't say anything about websites", "reply_to_id": "c3-019", "reactions": [] },
    { "id": "c3-021", "from": "employee.a@sdworx.example", "created_at": "2026-10-09T13:30:00+02:00", "text": "let's agree to disagree 😅", "reply_to_id": "c3-020", "reactions": [] },
    { "id": "c3-022", "from": "employee.b@sdworx.example", "created_at": "2026-10-09T13:31:00+02:00", "text": "😅 fine", "reply_to_id": "c3-021", "reactions": [] },
    { "id": "c3-023", "from": "manager@sdworx.example", "created_at": "2026-10-09T15:00:00+02:00", "text": "let's park the website question for now", "reply_to_id": "c3-016", "reactions": [] },
